<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rx200_moveit_control</name>
  <version>1.0.0</version>
  <description>ROS2 package containing the GUI, input manager and MoveIt action client for the RX200 robot.</description>
  <maintainer email="KIAN.CURRANMAHON.2023@mumail.ie">Kian Anthony Curran Mahon</maintainer>
  <maintainer email="LENA.DUBOIS.2027@mumail.ie">Léna Isabel Estelle Dubois</maintainer>
  <maintainer email="CAELAN.ORAGHAILL.2023@mumail.ie">Caelan Pol Chaney Ó Raghaill</maintainer>
  <license>None</license>

  <depend>rclpy</depend>
  <depend>moveit_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>shape_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>


  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
